PORT=3000
COLLECTOR_PORT=4000
SEARCH_API_PORT=5000
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
OPENSEARCH_NODE=http://localhost:9200
ML_API_URL=http://localhost:8000
ML_API_TIMEOUT_MS=3000

# Multi-Channel Alert Configuration
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here
DISCORD_ENABLED=true

# Email Alert (Gmail SMTP)
EMAIL_ALERT_ENABLED=true
ADMIN_EMAIL=your_email@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com
SMTP_USE_SSL=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15

# Groq API Key for AI Assistant (primary — fast inference)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (fallback khi Groq hết quota)
GEMINI_API_KEY=your_gemini_api_key_here

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here

# Scheduled Reports & Retention Policy
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_CRON=0 8 * * *
RETENTION_DAYS=30
AUTO_CLEANUP_ENABLED=true
AUTO_CLEANUP_CRON=0 0 * * *
